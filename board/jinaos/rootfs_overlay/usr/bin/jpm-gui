#!/usr/bin/env python3

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib
import subprocess
import os
import threading

class JinaStore(Gtk.Window):
    def __init__(self):
        super().__init__(title="Jina Store")
        self.set_default_size(720, 1280)
        self.set_position(Gtk.WindowPosition.CENTER)
        
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)
        
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.set_margin_top(10)
        header.set_margin_bottom(10)
        header.set_margin_start(15)
        header.set_margin_end(15)
        vbox.pack_start(header, False, False, 0)
        
        logo = Gtk.Label()
        logo.set_markup("<span size='large' weight='bold'>Jina Store</span>")
        header.pack_start(logo, False, False, 0)
        
        spacer = Gtk.Label()
        header.pack_start(spacer, True, True, 0)
        
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search packages...")
        self.search_entry.connect("search-changed", self.on_search)
        header.pack_start(self.search_entry, False, False, 0)
        
        tabs = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        tabs.set_margin_start(15)
        tabs.set_margin_end(15)
        vbox.pack_start(tabs, False, False, 0)
        
        self.apps_tab = Gtk.Button(label="Apps")
        self.apps_tab.get_style_context().add_class("suggested-action")
        self.apps_tab.connect("clicked", self.show_apps)
        tabs.pack_start(self.apps_tab, True, True, 0)
        
        self.games_tab = Gtk.Button(label="Games")
        self.games_tab.connect("clicked", self.show_games)
        tabs.pack_start(self.games_tab, True, True, 0)
        
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scrolled, True, True, 0)
        
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=15)
        self.content_box.set_margin_top(20)
        self.content_box.set_margin_bottom(20)
        self.content_box.set_margin_start(15)
        self.content_box.set_margin_end(15)
        scrolled.add(self.content_box)
        
        self.loading = Gtk.Label()
        self.loading.set_markup("<span size='large'>Loading packages...</span>")
        
        status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        status.set_margin_top(10)
        status.set_margin_bottom(10)
        status.set_margin_start(15)
        status.set_margin_end(15)
        vbox.pack_start(status, False, False, 0)
        
        self.status_label = Gtk.Label()
        self.status_label.set_markup("<span size='small'>Ready</span>")
        status.pack_start(self.status_label, False, False, 0)
        
        self.packages = []
        self.filtered_packages = []
        self.current_tab = "apps"
        self.load_packages()
        
        self.show_all()
    
    def load_packages(self):
        self.clear_content()
        self.content_box.add(self.loading)
        self.loading.show()
        
        def load_thread():
            try:
                cache_dir = os.environ.get("JPM_CACHE_DIR", "/var/cache/jpm")
                packages_file = f"{cache_dir}/packages.txt"
                
                if os.path.exists(packages_file):
                    with open(packages_file, 'r') as f:
                        for line in f:
                            if line.startswith('#') or not line.strip():
                                continue
                            parts = line.strip().split(' ', 3)
                            if len(parts) >= 3:
                                category = parts[2] if len(parts) > 2 else "apps"
                                desc = parts[3] if len(parts) > 3 else "No description"
                                self.packages.append({
                                    'name': parts[0],
                                    'version': parts[1],
                                    'category': category,
                                    'description': desc
                                })
                
                GLib.idle_add(self.refresh_display)
            except Exception as e:
                GLib.idle_add(self.show_error, str(e))
        
        threading.Thread(target=load_thread, daemon=True).start()
    
    def refresh_display(self):
        self.content_box.remove(self.loading)
        self.apply_filter()
        return False
    
    def clear_content(self):
        for child in self.content_box.get_children():
            self.content_box.remove(child)
    
    def apply_filter(self):
        self.clear_content()
        
        search_text = self.search_entry.get_text().lower()
        
        self.filtered_packages = []
        for pkg in self.packages:
            if self.current_tab == "apps" and pkg['category'] != "apps":
                continue
            if self.current_tab == "games" and pkg['category'] != "games":
                continue
            if search_text and search_text not in pkg['name'].lower() and search_text not in pkg['description'].lower():
                continue
            self.filtered_packages.append(pkg)
        
        if not self.filtered_packages:
            empty = Gtk.Label()
            empty.set_markup("<span size='large'>No packages found</span>")
            self.content_box.pack_start(empty, False, False, 0)
            return
        
        for pkg in self.filtered_packages:
            self.create_package_card(pkg)
        
        self.status_label.set_markup(f"<span size='small'>{len(self.filtered_packages)} packages found</span>")
    
    def create_package_card(self, pkg):
        frame = Gtk.Frame()
        frame.set_margin_bottom(5)
        
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        vbox.set_margin_top(10)
        vbox.set_margin_bottom(10)
        vbox.set_margin_start(10)
        vbox.set_margin_end(10)
        frame.add(vbox)
        
        name_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        name = Gtk.Label()
        name.set_markup(f"<span weight='bold' size='large'>{pkg['name']}</span>")
        name_box.pack_start(name, False, False, 0)
        
        version = Gtk.Label()
        version.set_markup(f"<span size='small' color='gray'>v{pkg['version']}</span>")
        name_box.pack_start(version, False, False, 0)
        
        name_box.pack_start(Gtk.Label(), True, True, 0)
        vbox.pack_start(name_box, False, False, 0)
        
        desc = Gtk.Label()
        desc.set_markup(f"<span size='small'>{pkg['description']}</span>")
        desc.set_line_wrap(True)
        desc.set_xalign(0)
        vbox.pack_start(desc, False, False, 0)
        
        # Check if installed
        installed = self.is_installed(pkg['name'])
        
        button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        button_box.pack_start(Gtk.Label(), True, True, 0)
        
        if installed:
            status_label = Gtk.Label()
            status_label.set_markup("<span color='green'>Installed</span>")
            button_box.pack_start(status_label, False, False, 0)
            
            remove_btn = Gtk.Button(label="Remove")
            remove_btn.connect("clicked", self.remove_package, pkg['name'])
            button_box.pack_start(remove_btn, False, False, 0)
        else:
            install_btn = Gtk.Button(label="Install")
            install_btn.get_style_context().add_class("suggested-action")
            install_btn.connect("clicked", self.install_package, pkg['name'])
            button_box.pack_start(install_btn, False, False, 0)
        
        vbox.pack_start(button_box, False, False, 5)
        
        self.content_box.pack_start(frame, False, False, 0)
    
    def is_installed(self, package):
        return os.path.exists(f"/var/lib/jpm/installed/{package}")
    
    def install_package(self, button, package):
        self.status_label.set_markup(f"<span size='small'>Installing {package}...</span>")
        
        def install_thread():
            result = subprocess.run(["sudo", "jpm", "install", package], capture_output=True, text=True)
            GLib.idle_add(self.install_complete, package, result.returncode, result.stdout)
        
        threading.Thread(target=install_thread, daemon=True).start()
    
    def install_complete(self, package, returncode, output):
        if returncode == 0:
            self.status_label.set_markup(f"<span size='small' color='green'>Installed {package}</span>")
        else:
            self.status_label.set_markup(f"<span size='small' color='red'>Failed: {output[:100]}</span>")
        self.apply_filter()
    
    def remove_package(self, button, package):
        self.status_label.set_markup(f"<span size='small'>Removing {package}...</span>")
        
        def remove_thread():
            result = subprocess.run(["sudo", "jpm", "remove", package], capture_output=True, text=True)
            GLib.idle_add(self.remove_complete, package, result.returncode)
        
        threading.Thread(target=remove_thread, daemon=True).start()
    
    def remove_complete(self, package, returncode):
        if returncode == 0:
            self.status_label.set_markup(f"<span size='small' color='green'>Removed {package}</span>")
        else:
            self.status_label.set_markup(f"<span size='small' color='red'>Failed to remove {package}</span>")
        self.apply_filter()
    
    def show_apps(self, button):
        self.current_tab = "apps"
        self.apps_tab.get_style_context().add_class("suggested-action")
        self.games_tab.get_style_context().remove_class("suggested-action")
        self.apply_filter()
    
    def show_games(self, button):
        self.current_tab = "games"
        self.games_tab.get_style_context().add_class("suggested-action")
        self.apps_tab.get_style_context().remove_class("suggested-action")
        self.apply_filter()
    
    def on_search(self, entry):
        self.apply_filter()
    
    def show_error(self, error):
        self.content_box.remove(self.loading)
        error_label = Gtk.Label()
        error_label.set_markup(f"<span color='red'>Error: {error}</span>")
        self.content_box.pack_start(error_label, False, False, 0)
        return False

if __name__ == "__main__":
    win = JinaStore()
    Gtk.main()